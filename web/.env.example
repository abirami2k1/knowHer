# knowHer web — environment variables
#
# Copy this file to /web/.env.local and fill in real values. `.env.local` is gitignored.
# Vite exposes only VITE_* variables to the browser, and everything here ships
# in the public bundle — so NOTHING in this file may ever be a secret.

# ── API (Task 1.3.6) ─────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000

# ── AWS Cognito (Task 3) ─────────────────────────────────────────────────
# Same user pool + app client as /api/.env — see README "Auth: AWS Cognito user pool".
# Pool and client IDs are public identifiers, not secrets. The app client must be a
# public (SPA) client with NO client secret and SRP auth enabled.
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Later phases ─────────────────────────────────────────────────────────
# Error monitoring (architecture §5b). Empty/unset = disabled.
# VITE_SENTRY_DSN=
