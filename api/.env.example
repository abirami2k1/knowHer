# knowHer API — environment variables
#
# Copy this file to /api/.env and fill in real values. `.env` is gitignored.
# This file holds PLACEHOLDERS ONLY — never paste a real secret here.

# ── Server ───────────────────────────────────────────────────────────────
PORT=4000
# Exact origin of the web app, allowed by CORS (no wildcard). Dev = Vite dev server.
WEB_ORIGIN=http://localhost:5173

# ── Database (Task 2) ────────────────────────────────────────────────────
# Local dev value matches docker-compose.yml (`docker compose up -d db`).
# Production points at RDS and is set as a deploy secret, never committed.
DATABASE_URL=postgresql://knowher:knowher@localhost:5433/knowher?schema=public

# ── AWS Cognito (Task 3) ─────────────────────────────────────────────────
# Created by hand in the AWS console — see README "Auth: AWS Cognito user pool".
# Same pool + app client as /web/.env.local. IDs are public identifiers, not secrets.
# The API verifies access tokens against the pool's JWKS (no credentials needed for that).
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Account deletion (Task 12, decision D8) ──────────────────────────────
# DELETE /account disables then deletes the user's Cognito account, which needs
# IAM permission: cognito-idp:AdminDisableUser, AdminEnableUser, AdminDeleteUser
# on this pool only. Production uses the EC2 instance role (no keys here). Locally,
# use a named profile or these two vars for a narrowly-scoped dev IAM user.
# Without credentials, deletion fails closed: nothing is removed, the user is told
# to try again. See README "Account deletion".
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Later phases (leave commented until the phase that wires them) ──────
# Error monitoring (architecture §5b). Empty/unset = disabled.
# SENTRY_DSN=
# S3 bucket for blog/knowledge images — keep-or-drop decided at Task 11.0.6.
# S3_BUCKET=
# ── Web push / daily nudge (Task 13.0.1) ─────────────────────────────────
# Generate a pair with `npx web-push generate-vapid-keys`. The public key is
# served to the browser by GET /push/key, so /web needs no push variable of its
# own and the key can be rotated without rebuilding the app. The private key is
# a real secret: local .env and the prod deploy secrets only.
# VAPID_SUBJECT is how a push service reaches you about a problem.
# Leave all three unset and the nudge is simply off — every other route works.
# Rotating the pair invalidates existing subscriptions; everyone opts in again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
