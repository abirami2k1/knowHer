// knowHer — Prisma schema
//
// Decisions encoded here (see context/architecture.md D1–D8):
//  - All user-facing dates are plain local calendar dates (@db.Date), chosen
//    client-side as YYYY-MM-DD. The server never derives "today" from a UTC clock
//    for user data; Zod validates the shape at the route boundary.
//  - DailyLog has NO cycleId: cycle membership is derived from Cycle date ranges.
//  - Assessment fields on Cycle are a SNAPSHOT written when the cycle closes
//    (live cycles are computed on read). expectedOvulation is never stored.
//  - CycleSummary ships now; the retention job that populates+prunes is deferred.
//
// Schema changes go through migrations only (`npm run migrate:dev`). Never `db push`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Flow {
  none
  spotting
  light
  medium
  heavy
}

enum CervicalMucus {
  dry
  sticky
  watery
  eggwhite
}

enum CervixPosition {
  firm // shown as F
  medium // shown as M
  soft // shown as S
}

enum AgeBand {
  under18
  b18_24
  b25_34
  b35_44
  b45_plus
}

enum Condition {
  pcod
  pmdd
  endo
  none
  unsure
}

enum Goal {
  understand_body
  track_period
  ovulation_awareness
  plan_life
  manage_condition
  learn
}

enum Role {
  user
  author
}

enum Audience {
  user
  supporter
  both
}

// ── Models ───────────────────────────────────────────────────────────────

model User {
  id              String      @id @default(cuid())
  cognitoSub      String      @unique
  displayName     String?
  ageBand         AgeBand?
  conditions      Condition[] @default([]) // Zod refine: none/unsure are exclusive of the rest
  goals           Goal[]      @default([])
  trackingBBT     Boolean     @default(false)
  trackingMucus   Boolean     @default(false)
  avgCycleLength  Int? // self-reported at onboarding; refined from history
  avgPeriodLength Int?
  tempUnit        String      @default("F") // locked to F for MVP
  role            Role        @default(user) // D7: roles live here, not in Cognito groups
  onboardedAt     DateTime? // null = onboarding not finished (route guard)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  cycles      Cycle[]
  dailyLogs   DailyLog[]
  summaries   CycleSummary[]
  blogPosts   BlogPost[]
  pushDevices PushSubscription[]
}

model Cycle {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime  @db.Date // local calendar date (D1), client-chosen
  endDate   DateTime? @db.Date // set when the NEXT period start closes this cycle
  length    Int? // derived, persisted on close
  // NOTE: a cycle is "complete" iff endDate != null — no separate flag to drift.
  // expectedOvulation is deliberately NOT a column: always computed on read (D4).

  // Assessment snapshot — null while cycle is live (computed on read),
  // written by the engine when the cycle closes or its logs are edited.
  coverlineF     Decimal? @db.Decimal(5, 2)
  ovulationDay   Int? // cycle day (1-based)
  peakDay        Int?
  lutealLength   Int?
  isAnovulatory  Boolean  @default(false)
  confidence     String? // full | reduced | none
  confidenceNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startDate])
}

model DailyLog {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date // local calendar date (D1), client-chosen — never a UTC instant
  // No cycleId (D2): the owning cycle is whichever Cycle's [startDate, endDate] contains `date`.

  flow            Flow?
  bbtF            Decimal?        @db.Decimal(5, 2) // e.g. 97.65
  tempTakenAt     String? // local "HH:mm", NOT a UTC instant
  isDisturbed     Boolean         @default(false)
  disturbedReason String?
  cervicalMucus   CervicalMucus?
  cervixPosition  CervixPosition?
  mood            String? // controlled vocab in /shared
  energy          Int? // 1–5
  symptoms        String[]        @default([]) // controlled vocab in /shared (queryable, unlike Json)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // one entry per day; also serves userId lookups
}

model CycleSummary {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleStartDate   DateTime @db.Date
  cycleLength      Int
  ovulationDay     Int?
  peakDay          Int?
  lutealLength     Int?
  avgBbtF          Decimal? @db.Decimal(5, 2)
  symptomAggregate Json // { symptom: countByPhaseOrTotal }
  energyAggregate  Json // { phase: avgEnergy }
  notes            String?
  createdAt        DateTime @default(now())

  @@unique([userId, cycleStartDate])
}

model BlogPost {
  id           String    @id @default(cuid())
  authorId     String
  // Restrict (D8): an author account with posts cannot be hard-deleted; the delete
  // flow must surface "reassign or remove your posts first" instead of failing
  // mid-transaction. (Regular users have no posts and are unaffected.)
  author       User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  title        String
  slug         String    @unique
  bodyMarkdown String
  audience     Audience  @default(user)
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isPublished, audience])
}

model KnowledgeArticle {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  bodyMarkdown String
  category     String // basics | cycle | supporters
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, orderIndex])
}

/// D8: a deleted account whose Cognito user could not be removed on the spot.
/// The user is already disabled and every DB row is gone; this holds only the
/// Cognito subject so the API can retry on boot and daily. No health data.
model PendingCognitoDeletion {
  id         String   @id @default(cuid())
  cognitoSub String   @unique
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// One browser the user has opted in to the daily nudge from (Task 13).
/// She may say yes on her phone and not on her laptop, so the nudge time and
/// timezone live per device — this is the ONE place a timezone is stored
/// (everything else in knowHer is a plain local calendar date, D1).
/// Holds no health data: the nudge never names a phase, a symptom or a date.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The push service URL for this browser. Unique: re-subscribing the same
  /// browser updates the row rather than piling up duplicates.
  endpoint String @unique
  /// Encryption material handed over by the browser at opt-in.
  p256dh   String
  auth     String

  /// When she wants it, in her own local clock — "HH:mm", never a UTC instant.
  nudgeTime String @default("20:00")
  /// IANA zone captured at opt-in (e.g. "Asia/Kolkata"), so "20:00" means
  /// 20:00 where she is, and keeps meaning that across a DST change.
  timeZone  String

  /// The local calendar date this device was last nudged on, so a sweep that
  /// runs twice in the same minute cannot send twice.
  lastNudgedOn DateTime? @db.Date
  /// Consecutive delivery failures; the sweep drops a device the push service
  /// has declared gone (404/410) immediately, this catches the quieter ones.
  failures     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([nudgeTime])
}
